{
  "id": "error-handling-subworkflow",
  "name": "Centralized Error Handling Sub-Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "e1a2b3c4-0001-4000-8000-000000000001",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        100
      ]
    },
    {
      "parameters": {},
      "id": "e1a2b3c4-0002-4000-8000-000000000002",
      "name": "Sub-Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const executionData = $json || {};\nconst errorObj = executionData.execution?.error || executionData.error || {};\n\nconst formattedError = {\n  timestamp: new Date().toISOString(),
  workflowName: executionData.workflow?.name || 'VocalAssistAI Main Workflow',\n  workflowId: executionData.workflow?.id || 'main-workflow',\n  executionId: executionData.execution?.id || 'N/A',\n  failedNodeName: errorObj.node?.name || executionData.nodeName || 'Unknown Node',\n  failedNodeType: errorObj.node?.type || executionData.nodeType || 'Unknown Type',\n  errorMessage: errorObj.message || executionData.errorMessage || 'An unexpected execution error occurred',\n  errorDescription: errorObj.description || 'No additional stack trace details',\n  severity: executionData.severity || 'HIGH',\n  ticketId: executionData.ticketId || executionData.payload?._id || 'N/A',\n  customerContact: executionData.customerContact || executionData.payload?.customerContact || 'N/A',\n  channel: executionData.channel || executionData.payload?.channel || 'Unknown'\n};\n\nreturn [{ json: formattedError }];"
      },
      "id": "e1a2b3c4-0003-4000-8000-000000000003",
      "name": "Format Error Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        350,
        200
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "base": "={{ $env.AIRTABLE_BASE_ID }}",
        "table": "Error Logs",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "Workflow": "={{ $json.workflowName }}",
            "Node": "={{ $json.failedNodeName }}",
            "Error Message": "={{ $json.errorMessage }}",
            "Severity": "={{ $json.severity }}",
            "Ticket ID": "={{ $json.ticketId }}",
            "Channel": "={{ $json.channel }}"
          }
        }
      },
      "id": "e1a2b3c4-0004-4000-8000-000000000004",
      "name": "Log Error to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        600,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL || 'http://localhost:5000' }}/tickets/errors",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "e1a2b3c4-0005-4000-8000-000000000005",
      "name": "Log Error to Backend API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL || 'alerts@vocalassist.ai' }}",
        "toEmail": "={{ $env.SUPPORT_ADMIN_EMAIL || 'admin@vocalassist.ai' }}",
        "subject": "=[VocalAssistAI Alert] High Priority Workflow Error: {{ $json.failedNodeName }}",
        "html": "=<h2>🚨 VocalAssistAI Workflow Execution Failure</h2><p>An error occurred during workflow processing.</p><table border='1' cellpadding='8' style='border-collapse: collapse;'><tr><td><b>Timestamp</b></td><td>{{ $json.timestamp }}</td></tr><tr><td><b>Workflow</b></td><td>{{ $json.workflowName }} ({{ $json.workflowId }})</td></tr><tr><td><b>Failed Node</b></td><td>{{ $json.failedNodeName }} ({{ $json.failedNodeType }})</td></tr><tr><td><b>Error Message</b></td><td><span style='color: red;'>{{ $json.errorMessage }}</span></td></tr><tr><td><b>Severity</b></td><td>{{ $json.severity }}</td></tr><tr><td><b>Associated Ticket ID</b></td><td>{{ $json.ticketId }}</td></tr><tr><td><b>Channel</b></td><td>{{ $json.channel }}</td></tr></table><p>Please log in to the VocalAssistAI Dashboard or n8n console to inspect the execution.</p>"
      },
      "id": "e1a2b3c4-0006-4000-8000-000000000006",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        850,
        200
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format Error Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sub-Workflow Trigger": {
      "main": [
        [
          {
            "node": "Format Error Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error Context": {
      "main": [
        [
          {
            "node": "Log Error to Airtable",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log Error to Backend API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error to Airtable": {
      "main": [
        [
          {
            "node": "Send Alert Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error to Backend API": {
      "main": [
        [
          {
            "node": "Send Alert Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "e1a2b3c4-0000-4000-8000-000000000000",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": [
    "Error-Handling",
    "Sub-Workflow"
  ]
}
