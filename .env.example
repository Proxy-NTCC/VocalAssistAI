# VocalAssistAI: Global Environment Configuration Example
# Copy this file to create your specific .env files in backend and frontend

# ==========================================
# 1. Backend Service Configuration (Express)
# ==========================================
PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ==========================================
# 2. Frontend Service Configuration (Vite)
# ==========================================
# Note: In the React/Vite project, create a separate .env file
# under Frontend/Frontend/Frontend-Demo/ containing:
VITE_API_URL=http://localhost:3000

# ==========================================
# 3. n8n Workflow & Custom Node Configuration
# ==========================================
# Inject these variables into the environment running your n8n server
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_PROTOCOL=https
OPENAI_API_HOST=api.openai.com
OPENAI_API_PORT=443
OPENAI_API_PATH=/v1/chat/completions

# Airtable CRM Sync Settings
AIRTABLE_BASE_ID=appVocalAssist101
AIRTABLE_TABLE_NAME=Tickets
AIRTABLE_PAT=pat_vocal_assist_secret_key_here

# Pinecone Vector Database Settings
PINECONE_API_KEY=pc_key_vocal_assist_similarity_search_here
PINECONE_INDEX=vocal-tickets-embeddings
