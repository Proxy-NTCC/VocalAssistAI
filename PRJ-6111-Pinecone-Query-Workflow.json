{
  "name": "Pinecone Similar Tickets Query",
  "nodes": [
    {
      "parameters": {},
      "id": "e6a1005a-3512-4f3b-85d0-9a3c20fbd581",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        50,
        300
      ]
    },
    {
      "parameters": {
        "resource": "embeddings",
        "model": "text-embedding-3-small",
        "input": "={{ $json.ticket_text }}"
      },
      "id": "1831e50a-f0b4-4b5b-8287-6e54f738a9a4",
      "name": "OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "openAiApi",
          "name": "OpenAI account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PINECONE_INDEX_URL }}/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"vector\": {{ JSON.stringify($json.data[0].embedding || $json.embedding) }},\n  \"topK\": 5,\n  \"includeMetadata\": true\n}",
        "options": {}
      },
      "id": "01c9a6ff-d3c5-4424-9b8f-1a9829b35b43",
      "name": "Pinecone Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pineconeApiHeader",
          "name": "Pinecone API Key"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const matches = $input.first().json.matches || [];\nreturn { json: { similar_tickets: matches.map(m => m.metadata) } };"
      },
      "id": "890251fb-27e1-4c7b-b34e-030b427b55db",
      "name": "Parse Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        450
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e936b28a-7e18-40be-bd6e-1f2a36b33535",
              "name": "attemptCount",
              "value": 0,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "init-attempt-count",
      "name": "Initialize Attempt Count",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        250,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-error-cond",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-for-error",
      "name": "Check for Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 3.2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "$json.attemptCount = ($json.attemptCount || 0) + 1;\nreturn $json;"
      },
      "id": "increment-count",
      "name": "Increment Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-limit-cond",
              "leftValue": "={{ $json.attemptCount }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-retry-limit",
      "name": "Check Retry Limit",
      "type": "n8n-nodes-base.if",
      "typeVersion": 3.2,
      "position": [
        1050,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://monitoring.internal.example.com/api/logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"level\": \"warning\",\n  \"workflow\": \"{{ $workflow.name }}\",\n  \"status\": \"Retrying\",\n  \"attemptCount\": {{ $json.attemptCount }},\n  \"error_message\": \"{{ $json.error.message }}\",\n  \"node\": \"{{ $json.execution.lastNodeExecuted }}\"\n}",
        "options": {}
      },
      "id": "log-retry",
      "name": "Log Retry to Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1250,
        50
      ]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait-node",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1450,
        50
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://monitoring.internal.example.com/api/logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"level\": \"error\",\n  \"workflow\": \"{{ $workflow.name }}\",\n  \"status\": \"Final Failure\",\n  \"attemptCount\": {{ $json.attemptCount }},\n  \"error_message\": \"{{ $json.error.message }}\",\n  \"node\": \"{{ $json.execution.lastNodeExecuted }}\"\n}",
        "options": {}
      },
      "id": "log-final-failure",
      "name": "Log Final Failure to Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1250,
        250
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Initialize Attempt Count",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Attempt Count": {
      "main": [
        [
          {
            "node": "OpenAI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI": {
      "main": [
        [
          {
            "node": "Pinecone Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pinecone Query": {
      "main": [
        [
          {
            "node": "Check for Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check for Error": {
      "main": [
        [
          {
            "node": "Increment Count",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Parse Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Increment Count": {
      "main": [
        [
          {
            "node": "Check Retry Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Retry Limit": {
      "main": [
        [
          {
            "node": "Log Retry to Dashboard",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Final Failure to Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Retry to Dashboard": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
